DirectoryIndex index.html
Options -Indexes

<IfModule mod_mime.c>
  AddType application/pdf .pdf
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "^(index\.html|Jericho-Ivan-Villamor-Resume\.pdf)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.pdf$">
    Header set X-Content-Type-Options "nosniff"
  </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} !^jerichovillamordev\.com(?::[0-9]+)?$ [NC]
  RewriteRule ^(.*)$ https://jerichovillamordev.com/$1 [R=301,L]
</IfModule>
